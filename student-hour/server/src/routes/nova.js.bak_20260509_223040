}

function detectEmotionalState(messages) {
  if (!messages?.length) return 'neutral'
  const recent = messages.slice(-4).map(m => m.content?.toLowerCase() || '').join(' ')
  if (['dont understand', "don't understand", 'confused', 'lost', 'not getting', 'i give up', 'frustrat', 'am confused', 'i cant'].some(w => recent.includes(w))) return 'frustrated'
  if (['i see', 'i get it', 'that makes sense', 'understood', 'got it'].some(w => recent.includes(w))) return 'confident'
  return 'neutral'
}

function extractKnowledgeTrace(memoryRows) {
  if (!memoryRows?.length) return []
  const skills = {}
  memoryRows.forEach(row => {
    const text = row.content || ''
    ;(text.match(/correct[ly]* on ([^,."]+)/gi) || []).forEach(m => {
      const skill = m.replace(/correct[ly]* on /i, '').trim().slice(0, 40)
      if (!skills[skill]) skills[skill] = { correct: 0, total: 0 }
      skills[skill].correct++; skills[skill].total++
    })
    ;(text.match(/struggle[ds]* with ([^,."]+)/gi) || []).forEach(m => {
      const skill = m.replace(/struggle[ds]* with /i, '').trim().slice(0, 40)
      if (!skills[skill]) skills[skill] = { correct: 0, total: 0 }
      skills[skill].total++
    })
  })
  return Object.entries(skills).map(([skill, { correct, total }]) => ({ skill, mastery: Math.round((correct / total) * 100) })).slice(0, 8)
}

