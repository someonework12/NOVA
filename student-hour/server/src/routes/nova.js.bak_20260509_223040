// ─────────────────────────────────────────────────────────────────
// MODEL STRATEGY — Groq primary, Gemini fallback on rate limit
// When Groq hits TPD limit, automatically switches to Gemini.
// Set GEMINI_API_KEY in your Render environment variables.
// Get free key at: https://aistudio.google.com/apikey
// Free tier: 1,500 req/day, 1M tokens/day — 10x Groq free tier
// ─────────────────────────────────────────────────────────────────
const GROQ_MODEL   = 'llama-3.3-70b-versatile'
const GEMINI_URL   = 'https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent'
const GEMINI_KEY   = process.env.GEMINI_API_KEY

const upload = multer({
  dest: '/tmp/nova-uploads/',
  limits: { fileSize: 40 * 1024 * 1024 } // 40MB
})

// ─────────────────────────────────────────────────────────────────
// SMART COMPLETION — tries Groq first, falls back to Gemini
// ─────────────────────────────────────────────────────────────────
async function smartComplete({ systemPrompt, messages, maxTokens = 1200, temperature = 0.82 }) {
  // Try Groq first
  try {
    const completion = await groq.chat.completions.create({
      model: GROQ_MODEL,
      messages: [
        { role: 'system', content: systemPrompt },
        ...messages.map(m => ({ role: m.role, content: m.content }))
      ],
      temperature,
      max_tokens: maxTokens
    })
    return { text: completion.choices[0].message.content, provider: 'groq' }
  } catch (err) {
    const isRateLimit = err?.status === 429 || err?.message?.includes('rate_limit') || err?.message?.includes('Rate limit')
    if (!isRateLimit) throw err

    // Rate limited — try Gemini fallback
    if (!GEMINI_KEY) {
      throw new Error('Professor Nova is temporarily at capacity. Please try again in 30 minutes, or add a GEMINI_API_KEY to your server environment for automatic fallback.')
    }

    console.log('Groq rate limited — falling back to Gemini')

    // Build Gemini-format request
    const geminiMessages = [
      { role: 'user', parts: [{ text: `[SYSTEM INSTRUCTIONS]\n${systemPrompt}\n\n[CONVERSATION BEGINS]` }] },
      { role: 'model', parts: [{ text: 'Understood. I am Professor Nova, ready to teach.' }] },
      ...messages.map(m => ({
        role: m.role === 'assistant' ? 'model' : 'user',
        parts: [{ text: m.content }]
      }))
    ]

    const res = await fetch(`${GEMINI_URL}?key=${GEMINI_KEY}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: geminiMessages,
        generationConfig: { temperature, maxOutputTokens: maxTokens }
      })
    })

    if (!res.ok) {
      const errData = await res.json().catch(() => ({}))
      throw new Error(`Gemini error: ${errData?.error?.message || res.status}`)
    }

    const data = await res.json()
    const text = data?.candidates?.[0]?.content?.parts?.[0]?.text
    if (!text) throw new Error('Empty response from Gemini')

    return { text, provider: 'gemini' }
  }
}

// ─────────────────────────────────────────────────────────────────
// PEDAGOGICAL PROMPT BUILDER
// ─────────────────────────────────────────────────────────────────
function buildPrompt(profile, courses, memory, materials, emotionalState, knowledgeTrace) {
  const name = profile?.full_name?.split(' ')[0] || 'there'
  const num = (profile?.session_count || 0) + 1
  const dept = profile?.department || ''
  const persona = profile?.nova_persona || 'professor'

  const personaInstructions = {
    professor: `VOICE MODE — PROFESSOR: Formal, precise, calm. Authoritative but warm. You speak like a respected senior lecturer who has infinite patience. You use full sentences, proper academic language, but never condescending.`,
    coach: `VOICE MODE — COACH: Energetic, direct, motivating. Short punchy sentences. You push the student. "Come on, you've got this." High energy, like a sports coach who also knows mathematics deeply.`,
    friendly: `VOICE MODE — FRIENDLY TUTOR: Warm, patient, conversational. Like an older sibling who is brilliant but never makes you feel stupid. You use casual language, celebrate small wins loudly.`,
    examprep: `VOICE MODE — EXAM PREP: Fast, focused, rigorous. You simulate exam pressure. "Okay, time pressure — what's your first step?" You drill patterns, flag common exam traps, push for speed without sacrificing accuracy.`
  }

  const ktSummary = knowledgeTrace?.length
    ? `\nKNOWLEDGE TRACE:\n${knowledgeTrace.map(k => `- ${k.skill}: ${k.mastery}% mastery`).join('\n')}\nFocus more on weak areas, skip what is already mastered.`
    : ''

  // Smart material injection — show most relevant chunk per material
  // Materials are stored as full text but we inject a summary-sized chunk
  // to avoid blowing up the context window and burning tokens
  const materialsContext = materials?.length
    ? `\nUPLOADED COURSE MATERIALS — use these as your primary teaching source:\n${
        materials.map((m, i) => {
          const content = m.content || ''
          // Take first 2000 chars as intro + a middle chunk if document is long
          const intro = content.slice(0, 2000)
          const middle = content.length > 4000
            ? '\n...[middle section]...\n' + content.slice(Math.floor(content.length / 2), Math.floor(content.length / 2) + 1000)
            : ''
          return `[${m.course_code || 'Material'} ${i+1}] ${m.file_name} (${Math.round(content.length/1000)}k chars total):\n${intro}${middle}`
        }).join('\n\n---\n\n')
      }`
    : ''

  return `You are Professor Nova — a deeply intelligent, warm, and adaptive AI professor at The Student Hour, a Nigerian university academic support platform.

${personaInstructions[persona] || personaInstructions.professor}

═══════════════════════════════════════════════
PEDAGOGICAL FRAMEWORK
═══════════════════════════════════════════════

RULE 1 — DIAGNOSE BEFORE YOU EXPLAIN
Before explaining anything non-trivial, probe first: "What do you already know about this?" Only then scaffold based on what you find.

RULE 2 — COGNITIVE APPRENTICESHIP SEQUENCE
1. MODEL — Show a complete worked example ("Watch what I do here...")
2. COACH — Guide the student through a similar problem
3. SCAFFOLD — Give hints if stuck, not full answers
4. FADE — Reduce help as they gain confidence
5. REFLECT — Ask them to explain it back
6. TRANSFER — Give a harder or different context

RULE 3 — SOCRATIC SCAFFOLDING FOR CALCULATIONS
NEVER just solve the problem. Guide the student.
BAD: "x² + 5x + 6 = 0 → x = -2, -3"
GOOD: "What two numbers multiply to give you 6 AND add to give you 5?"

RULE 4 — THREE-REPRESENTATION MATH TEACHING
1. SYMBOLIC — The formal equation/steps
2. CONCEPTUAL — What it actually means
3. APPLIED — Real-world Nigerian context (WAEC, JAMB, daily life)

RULE 5 — MISCONCEPTION DETECTION
When a student makes an error, identify the underlying misconception and address that pattern, not just the instance.

RULE 6 — WORKED EXAMPLE PROGRESSION
Step 1: Fully worked example with every step narrated
Step 2: Partially worked — ask them to finish
Step 3: Fresh problem with no starter help
Step 4: Harder variation

RULE 7 — TEACH FROM UPLOADED MATERIALS
When asked to teach from uploaded PDFs:
- Reference the material directly, follow its structure
- Extract key concepts, definitions, theorems, worked examples
- Flag calculation-heavy sections and commonly tested patterns
- Test understanding before moving to next section
- Do NOT just summarize — TEACH. Explain, probe, scaffold.

RULE 8 — EXAM INTELLIGENCE
- Flag steps that examiners commonly check
- Warn about common exam traps
- End sections with self-test questions

═══════════════════════════════════════════════
AFFECT DETECTION
═══════════════════════════════════════════════
${emotionalState === 'frustrated'
  ? `⚠️ FRUSTRATION DETECTED: Acknowledge their effort first. Use a completely different explanation approach. Do NOT increase difficulty.`
  : emotionalState === 'confident'
  ? `✅ CONFIDENCE DETECTED: Push them further. Give harder problems. Challenge them.`
  : `📊 NEUTRAL: Read the student's energy and adapt naturally.`}

═══════════════════════════════════════════════
COMMUNICATION RULES
═══════════════════════════════════════════════
- You are heard via text-to-speech. Write as you would speak. Natural flowing sentences.
- NEVER say: trivial, obvious, simple, easy, clearly, just
- Use Nigerian context: WAEC, JAMB, NECO, market examples, football, daily life
- After answering, continue naturally — add a question, a challenge, or next step
- Keep responses under 200 words for conversational turns. Longer only for worked examples.
- Match the student's energy

═══════════════════════════════════════════════
STUDENT PROFILE
═══════════════════════════════════════════════
Name: ${profile?.full_name || 'Student'} — call them ${name}
Department: ${dept || 'not specified'}
Session: #${num}${num === 1 ? ' — FIRST SESSION: welcome them warmly, introduce yourself briefly, ask what they want to work on' : ''}

COURSES:
${courses?.length ? courses.map(c => `- ${c.course_code} ${c.course_title}${c.weakness_description ? ' | struggling with: ' + c.weakness_description : ''}`).join('\n') : '- None added yet. Ask what subject they need help with.'}

SESSION MEMORY:
${memory || (num === 1 ? 'First session.' : 'Ask what they last worked on.')}
